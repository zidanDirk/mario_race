# Copy to .env for local development. Never put secrets in VITE_* variables.
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
APP_RETURN_PATH=/
API_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/development.sqlite
# Explicit local-only test identity, not email or Google authentication.
DEV_AUTH_ENABLED=false
TRUST_PROXY=false
SERVE_STATIC=true
COOKIE_SAME_SITE=Lax
GOOGLE_CLIENT_ID=
# Local development exchanges directly with Google. Production in mainland China uses GOOGLE_RELAY_* instead.
GOOGLE_CLIENT_SECRET=
GOOGLE_RELAY_URL=
GOOGLE_RELAY_SECRET=
# Optional email code login through an SMTP provider such as Alibaba Cloud DirectMail.
EMAIL_SMTP_HOST=smtpdm.aliyun.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# Stable random value with at least 32 characters. Changing it changes email account identities.
EMAIL_AUTH_SECRET=
EMAIL_FROM_NAME=游戏星球
EMAIL_DAILY_LIMIT=200
