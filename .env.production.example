# Backend-only ECS deployment. APP_ORIGIN is the final HTTPS domain attached to Kodo.
DOMAIN=backend.zhangzidan.com
API_ORIGIN=https://backend.zhangzidan.com
APP_ORIGIN=https://games.zhangzidan.com
APP_RETURN_PATH=/marace/
# Used only while building the static Vite files for Kodo.
VITE_API_ORIGIN=https://backend.zhangzidan.com
NODE_ENV=production
DEV_AUTH_ENABLED=false
SERVE_STATIC=false
COOKIE_SAME_SITE=Lax
GOOGLE_CLIENT_ID=
# Google Client Secret is stored only in Cloudflare Worker secrets.
GOOGLE_RELAY_URL=https://mario-google-oauth-relay-pages.pages.dev/google/exchange
GOOGLE_RELAY_SECRET=
EMAIL_SMTP_HOST=smtpdm.aliyun.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_AUTH_SECRET=
EMAIL_FROM_NAME=游戏星球
EMAIL_DAILY_LIMIT=200
