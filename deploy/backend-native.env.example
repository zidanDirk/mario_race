NODE_ENV=production
API_ORIGIN=https://backend.zhangzidan.com
# Replace this after the Kodo website gets its final HTTPS custom domain.
APP_ORIGIN=https://games.zhangzidan.com
APP_RETURN_PATH=/marace/
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=/var/lib/mario-race/race.sqlite
DEV_AUTH_ENABLED=false
SERVE_STATIC=false
TRUST_PROXY=true
COOKIE_SAME_SITE=Lax
GOOGLE_CLIENT_ID=
# Production Google token exchange is relayed because mainland hosts cannot reliably reach Google APIs.
GOOGLE_RELAY_URL=https://mario-google-oauth-relay-pages.pages.dev/google/exchange
GOOGLE_RELAY_SECRET=
EMAIL_SMTP_HOST=smtpdm.aliyun.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_AUTH_SECRET=
EMAIL_FROM_NAME=游戏星球
EMAIL_DAILY_LIMIT=200
